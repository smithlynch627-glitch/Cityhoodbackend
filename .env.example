# Railway sets PORT automatically
PORT=8080
NODE_ENV=production

# mainnet (4663) or testnet (46630)
CHAIN=testnet
# Use a provider URL in production (Alchemy recommended); the public RPC is rate-limited
RPC_URL=https://rpc.testnet.chain.robinhood.com

# Printed by `npm run deploy:testnet` in /contracts
LAND_ADDRESS=
CITY_ADDRESS=
# Leave empty until the game is deployed: sale, mint and NFT images work without it (lands show as empty islands).
GAME_ADDRESS=
SALE_ADDRESS=
START_BLOCK=0
# Wallets whose $CITY isn't circulating (printed by the deploy script): game pools, sale, team lock, treasury
NONCIRCULATING_ADDRESSES=

# Sale voucher key — a fresh key that holds no funds. Its address goes into the contracts' SALE_SIGNER_ADDRESS.
SALE_SIGNER_PRIVATE_KEY=
# How long a purchase voucher stays valid (minutes)
VOUCHER_MINUTES=20

# Supabase (Project Settings -> API). Use the service_role key — this server is the only writer.
# Leave empty to run with an in-memory store (fine for local testing, resets on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URLs (used inside NFT metadata, X login and share links)
PUBLIC_API_URL=https://YOUR-BACKEND.up.railway.app
SITE_URL=https://YOUR-SITE.netlify.app

# Comma-separated list of allowed browser origins (empty = allow all)
CORS_ORIGIN=https://YOUR-SITE.netlify.app,http://localhost:5173

# Admin panel password (also works as a Bearer token for scripts). Use a long random string.
ADMIN_TOKEN=
# Signs user / admin sessions. Long random string, keep it stable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# X login for Citizenship (developer.x.com -> Projects & Apps -> your app -> User authentication settings:
# OAuth 2.0, type "Web App", callback = PUBLIC_API_URL/api/x/callback, website = SITE_URL)
X_CLIENT_ID=
X_CLIENT_SECRET=
# X_CALLBACK_URL defaults to PUBLIC_API_URL/api/x/callback
X_HANDLE=cityhood
# Optional: app bearer token for automatic task checks (paid X API tier). Without it, "X check" tasks go to admin review.
X_BEARER_TOKEN=

# Indexer tuning
POLL_MS=8000
LOG_CHUNK=2000
REFRESH_MINUTES=10
